__pycache__/
*.pyc
*.pyo
.venv/
venv/
dist/
.idea/
.vscode/
data/*
!data/.gitkeep
config.yml
.streamlit/secrets.toml
# Real env files hold bot/Turso/GitHub tokens — never commit them.
# Only .env.vercel.example (placeholders only) is tracked.
.env
.env.*
!.env.example
# Scanner writes run stats here (--stats-json); the workflow reads it in the
# next step and it never needs to be committed.
.tmp/
# Vercel CLI local state (project linkage, pulled env vars).
.vercel/
