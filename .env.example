# Local development credentials. Copy to .env — that file is gitignored.
#
#   cp .env.example .env
#
# Turso is required: there is no local-SQLite fallback, so the dashboard and
# the scanner always read the same rows. Get the values with:
#   turso db show <db> --url
#   turso db tokens create <db> --expiration none
TURSO_URL=libsql://<your-db>-<user>.turso.io
TURSO_AUTH_TOKEN=<token>

# Only needed to actually send Telegram messages locally. Leave the
# placeholder to run scans that just print to the console.
TG_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN

# Optional: public Streamlit URL, surfaced in /help and the pinned message.
# DASHBOARD_URL=https://poland-realestate-scanner.streamlit.app
