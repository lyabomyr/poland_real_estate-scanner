# Environment variables for the Vercel project that serves
# api/telegram_webhook.py  (the instant-reply Telegram webhook).
#
# ─── HOW TO USE ────────────────────────────────────────────────────────
#   1. cp .env.vercel.example .env.vercel
#   2. Fill the four REPLACE_ME values (see the command hints below).
#   3. Vercel dashboard -> your project -> Settings -> Environment Variables
#      -> "Import .env" -> upload .env.vercel
#      (or: vercel env add < .env.vercel  with the Vercel CLI)
#
# .env.vercel is gitignored. Never commit a filled-in copy.
# ───────────────────────────────────────────────────────────────────────


# ── Telegram ───────────────────────────────────────────────────────────

# Bot token from @BotFather. Same value as the TG_BOT_TOKEN GitHub secret.
#   grep bot_token config.yml
TG_BOT_TOKEN=REPLACE_ME

# Shared password between Telegram and this endpoint. The endpoint is public,
# so without it anyone could forge "commands from you" (change max_price,
# trigger /scan...). Our handler returns 403 when it doesn't match.
# Generate a fresh one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Use the SAME value when registering the webhook:
#   poetry run python scripts/manage_telegram_webhook.py set --secret "..."
TG_WEBHOOK_SECRET=REPLACE_ME

# Tells the scanner not to poll getUpdates (Telegram forbids polling while a
# webhook is registered). Keep this true in production.
TG_WEBHOOK_ENABLED=true


# ── Turso (shared state with the scanner + dashboard) ──────────────────

TURSO_URL=libsql://krakow-real-estate-lyabomyr.aws-eu-west-1.turso.io

# Same value as the TURSO_AUTH_TOKEN GitHub secret.
#   turso db tokens create krakow-real-estate --expiration none
TURSO_AUTH_TOKEN=REPLACE_ME


# ── /scan -> GitHub Actions workflow_dispatch ─────────────────────────

GITHUB_REPOSITORY_OWNER=lyabomyr
GITHUB_REPOSITORY_NAME=poland_real_estate-scanner
GITHUB_SCAN_WORKFLOW_FILE=scan.yml
GITHUB_SCAN_WORKFLOW_REF=main

# Fine-grained GitHub token, scoped to THIS repo, permission: Actions: write.
# https://github.com/settings/personal-access-tokens/new
# Only /scan needs it — leave as-is if you don't want the command.
GITHUB_WORKFLOW_TOKEN=REPLACE_ME


# ── Optional ───────────────────────────────────────────────────────────

# Public Streamlit URL, surfaced in /help, /status, /config and /dashboard.
# Fill in after you deploy the dashboard; also set it as a GitHub *variable*.
# DASHBOARD_URL=https://your-app.streamlit.app

# Fallback destination used only when no chat is registered+enabled in the
# chat_configs table. Chats self-register when you add the bot, so this is
# normally unnecessary.
# TG_CHAT_ID=-5411379431

# Restrict /scan to specific chat IDs (comma-separated). Unset = every
# registered+enabled chat may dispatch, still gated on chat-admin rights.
# TG_WORKFLOW_ALLOWED_CHAT_IDS=

# Additionally restrict /scan to specific Telegram user IDs.
# TG_WORKFLOW_ALLOWED_USER_IDS=

# /scan throttle. Defaults (from config.example.yml): 3 dispatches per 600 s,
# counted globally. Set TG_SCAN_MAX_PER_WINDOW=0 to disable.
# TG_SCAN_COOLDOWN_SECONDS=600
# TG_SCAN_MAX_PER_WINDOW=3
